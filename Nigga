-- Rainbow Generator
local function GetRainbowColor()
    return Color3.fromHSV(tick() % 4 / 4, 1, 1)
end

-- Wallcheck Raycast
local function IsVisible(targetPart)
    if not Config.Aimbot.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local ray = Ray.new(origin, (targetPart.Position - origin).Unit * 1000)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character})
    return hit and hit:IsDescendantOf(targetPart.Parent)
end

-- Get Aimbot Target
local function GetClosestTarget()
    local closest, maxDist = nil, Config.Aimbot.FOVSize
    local center = Config.Aimbot.FollowMouse and Vector2.new(Mouse.X, Mouse.Y) or Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    local candidates = {}
    if Config.Aimbot.TargetPlayers then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                if not Config.Aimbot.TeamCheck or p.Team ~= LocalPlayer.Team then
                    table.insert(candidates, p.Character)
                end
            end
        end
    end

    if Config.Aimbot.TargetNPCs then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(obj) then
                if obj.Humanoid.Health > 0 then
                    table.insert(candidates, obj)
                end
            end
        end
    end

    for _, char in pairs(candidates) do
        local part = char:FindFirstChild(Config.Aimbot.TargetPart) or char:FindFirstChild("HumanoidRootPart")
        if part and IsVisible(part) then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                if dist < maxDist then
                    maxDist = dist
                    closest = part
                end
            end
        end
    end
    return closest
end


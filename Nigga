-- Main Loop (RenderStepped)
RunService.RenderStepped:Connect(function()
    -- FOV Circle Update
    FOVCircle.Visible = Config.Aimbot.Enabled
    FOVCircle.Radius = Config.Aimbot.FOVSize
    FOVCircle.Color = Config.Aimbot.FOVRainbow and GetRainbowColor() or Color3.fromRGB(255, 255, 255)
    
    if Config.Aimbot.FollowMouse then
        FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y + 36) -- Offset สำหรับ top bar
    else
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end

    -- Aimbot Lock Execution
    if Config.Aimbot.Enabled then
        local target = GetClosestTarget()
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end

    -- TP Walk Logic
    if Config.Movement.TPWalk and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude > 0 then
            LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + (hum.MoveDirection * (Config.Movement.TPWalkSpeed / 5))
        end
    end

    -- JumpPower Logic
    if Config.Movement.CustomJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        hum.UseJumpPower = true
        hum.JumpPower = Config.Movement.JumpPower
    end

    -- Noclip Logic
    if Config.Movement.Noclip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- ESP System Loop
task.spawn(function()
    while task.wait(0.5) do
        if Config.ESP.Enabled then
            local currentThemeColor = Config.ESP.Rainbow and GetRainbowColor() or Color3.fromRGB(255, 0, 0)
            
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local char = p.Character
                    
                    -- Remove Old Highlights/Boxes
                    local oldHL = char:FindFirstChild("ESPHighlight")
                    local oldBB = char:FindFirstChild("ESPBillboard")
                    
                    if Config.ESP.Type == "Highlight" then
                        if oldBB then oldBB:Destroy() end
                        if not oldHL then
                            oldHL = Instance.new("Highlight", char)
                            oldHL.Name = "ESPHighlight"
                        end
                        oldHL.FillColor = currentThemeColor
                        oldHL.OutlineColor = Color3.fromRGB(255, 255, 255)
                    else
                        if oldHL then oldHL:Destroy() end
                        if not oldBB then
                            oldBB = Instance.new("SelectionBox", char)
                            oldBB.Name = "ESPBillboard"
                            oldBB.Adornee = char
                        end
                        oldBB.Color3 = currentThemeColor
                    end

                    -- Name ESP Toggle
                    local nameTag = char.HumanoidRootPart:FindFirstChild("ESPNameTag")
                    if Config.ESP.ShowNames then
                        if not nameTag then
                            nameTag = Instance.new("BillboardGui", char.HumanoidRootPart)
                            nameTag.Name = "ESPNameTag"
                            nameTag.Size = UDim2.new(0, 100, 0, 30)
                            nameTag.StudsOffset = Vector3.new(0, 3, 0)
                            nameTag.AlwaysOnTop = true
                            
                            local txt = Instance.new("TextLabel", nameTag)
                            txt.Size = UDim2.new(1, 0, 1, 0)
                            txt.BackgroundTransparency = 1
                            txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                            txt.TextStrokeTransparency = 0
                            txt.Font = Enum.Font.SourceSansBold
                            txt.TextSize = 14
                        end
                        nameTag.TextLabel.Text = p.Name
                        nameTag.TextLabel.TextColor3 = currentThemeColor
                    else
                        if nameTag then nameTag:Destroy() end
                    end
                end
            end
        else
            -- Clean all ESP
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character then
                    if p.Character:FindFirstChild("ESPHighlight") then p.Character.ESPHighlight:Destroy() end
                    if p.Character:FindFirstChild("ESPBillboard") then p.Character.ESPBillboard:Destroy() end
                    if p.Character:FindFirstChild("HumanoidRootPart") and p.Character.HumanoidRootPart:FindFirstChild("ESPNameTag") then
                        p.Character.HumanoidRootPart.ESPNameTag:Destroy()
                    end
                end
            end
        end
    end
end)
